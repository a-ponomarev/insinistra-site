# Normalize line endings to LF in the repository (avoids spurious CRLF diffs on Windows).
* text=auto eol=lf

# Binary assets — do not alter line endings or merge as text
*.jpg   binary
*.jpeg  binary
*.jpe   binary
*.png   binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.pdf   binary
*.mp3   binary
*.mp4   binary
